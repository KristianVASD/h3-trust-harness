# Environment template — copy to .env and fill in locally.
# Never commit real .env files.

# API
PORT=8787

# Store: file (local JSON under writable/) | postgres (Supabase)
STORE_DRIVER=file

# Optional: absolute path override for FileStore root
# WRITABLE_ROOT=

# When STORE_DRIVER=postgres (required for Vercel):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Auth: defaults to true when STORE_DRIVER=postgres, false for file
# AUTH_REQUIRED=true

# First account with this email is promoted to admin on login
# ADMIN_EMAIL=you@example.com

# Optional: anonymous Single Search quota per browser (default 5)
# SEARCH_SESSION_LIMIT=5

# Comma-separated browser origins for CORS (production)
# CORS_ORIGIN=https://your-app.vercel.app

# When seeding, also refresh committed fixtures (maintainers only)
# WRITE_FIXTURES=1

# Shared secret so the local engine worker can call Omega routes.
# At least 16 characters. Never put this in VITE_* or the browser.
# H3_WORKER_TOKEN=

# --- Local worker (pnpm worker) — never expose these to the harness ---
# H3_API_BASE=http://localhost:8787
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3:free
# WORKER_POLL_MS=5000
# WORKER_CONCURRENCY=2

# --- Harness (Vite) — put these in apps/harness/.env or root .env loaded by Vite ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
